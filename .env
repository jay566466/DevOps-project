# ════════════════════════════════════════════════════
#  AuthSystem — Environment Configuration
# ════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Core ─────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=3485c074a772251d41c0ce47775f21ab9e519d1e3539384e791c53fc19fecdfc

# ── Database ──────────────────────────────────────────
# Leave blank to use SQLite (default, fine for development)
# DATABASE_URL=YOUR_VALUE_HERE

# ── Admin Seed Account ────────────────────────────────
# Created automatically on first run. Change before deploying.
ADMIN_EMAIL=shreyaspatil566466@gmail.com
ADMIN_PASSWORD=Admin@123

# ── Token / OTP Settings ─────────────────────────────
TOKEN_EXPIRY_HOURS=24
OTP_EXPIRY_MINUTES=5

# ════════════════════════════════════════════════════
#  EMAIL CONFIGURATION
# ════════════════════════════════════════════════════
#
# OPTION A — Dev Mode (no real email, prints to console)
# ─────────────────────────────────────────────────────
# Set this to true and skip all MAIL_* settings below.
# All emails (OTP codes, verify links) will appear in
# your terminal window instead of being sent.
#
MAIL_DEV_MODE=false
#
# OPTION B — Gmail (real sending)
# ─────────────────────────────────────────────────────
# STEP 1: Enable 2-Step Verification on your Google account
#         https://myaccount.google.com/security
#
# STEP 2: Create an App Password (NOT your regular Gmail password)
#         https://myaccount.google.com/apppasswords
#         → Select app: "Mail"  → Select device: "Other"
#         → Copy the 16-character password shown
#
# STEP 3: Fill in below. MAIL_DEFAULT_SENDER must match MAIL_USERNAME.
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=jaypatil566466@gmail.com
MAIL_PASSWORD=cufi gzhh nkwt ttav
#
# ⚠️  IMPORTANT: MAIL_DEFAULT_SENDER must be identical to MAIL_USERNAME.
#     Gmail does NOT allow sending from a different address (e.g. noreply@...).
#     If you leave this blank it is set to MAIL_USERNAME automatically.
#
MAIL_DEFAULT_SENDER=jaypatil566466@gmail.com
#
# OPTION C — Other SMTP providers
# ─────────────────────────────────────────────────────
# SendGrid:  MAIL_SERVER=YOUR_VALUE_HERE
#            MAIL_USERNAME=YOUR_VALUE_HERE
#
# Mailgun:   MAIL_SERVER=YOUR_VALUE_HERE
#            MAIL_USERNAME=YOUR_VALUE_HERE
#
# Outlook:   MAIL_SERVER=YOUR_VALUE_HERE
#            MAIL_USERNAME=YOUR_VALUE_HERE
